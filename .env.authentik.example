# ── AUTHENTIK CONFIGURATION FOR FORENZX MCP HUB ────────────────────────
# Copy these values into your .env or .env.authentik file.
# Secrets must be generated using high-entropy random strings.
# Example: python -c "import secrets; print(secrets.token_urlsafe(50))"

# Secret key used for Authentik session encryption and cookie signing
AUTHENTIK_SECRET_KEY=7a6s45d4as7da5sd8as6d7ad987eaodauhd983y98d2221sad343141

# PostgreSQL credentials for Authentik
AUTHENTIK_POSTGRESQL_USER=authentik
AUTHENTIK_POSTGRESQL_NAME=authentik
AUTHENTIK_POSTGRESQL_PASSWORD=CHANGE_ME_GENERATE_WITH_secrets_token_urlsafe_32

# Client secret for ForenZX OIDC Application in Authentik
AUTHENTIK_FORENZX_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_secrets_token_urlsafe_48

# Web UI ports for Authentik
AUTHENTIK_PORT_HTTP=9000
AUTHENTIK_PORT_HTTPS=9443

# ── FORENZX OIDC ENABLER ──────────────────────────────────────────────
# Set these in your primary .env file to enable OIDC validation in ForenZX MCP Hub:
# OIDC_ENABLED=true
# OIDC_ISSUER_URL=http://authentik-server:9000/application/o/forenzx-mcp-hub/
# OIDC_JWKS_URL=http://authentik-server:9000/application/o/forenzx-mcp-hub/jwks/
# OIDC_AUDIENCE=forenzx-mcp-hub
