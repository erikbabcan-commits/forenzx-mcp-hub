# ForenZX MCP Hub — example environment configuration.
# Copy to .env and replace EVERY value marked CHANGE_ME.
# Production startup FAILS on placeholder, weak, or low-entropy secrets.

# ── APP ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DASHBOARD_ENABLED=true
DATA_DIR=/data

# ── AUTH ───────────────────────────────────────────────────────────────
# Secrets must be long AND high-entropy. Sequential/repeated characters
# are rejected even if the length check passes.
# Generate e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_secrets.token_urlsafe_48
SERVER_HMAC_SIGNING_KEY=CHANGE_ME_GENERATE_WITH_secrets.token_urlsafe_48
# Pydantic list values use JSON syntax.
API_KEYS=["CHANGE_ME_ANALYST_KEY"]
ADMIN_API_KEYS=["CHANGE_ME_ADMIN_KEY"]
ALLOWED_ORIGINS=["https://mcp.example.com"]

# ── MCP ───────────────────────────────────────────────────────────────
MCP_PROBE_TIMEOUT_SECONDS=8
MCP_HEALTH_INTERVAL_SECONDS=60
MCP_AUTO_HEALTH_ENABLED=true
# NOTE: a remote MCP server that answers HTTP 200 is HEALTHY, not TRUSTED.
# Every new server starts as UNVERIFIED. Trust must be granted explicitly
# via the admin trust endpoint and is audited.

# ── DATABASE ───────────────────────────────────────────────────────────
DATABASE_PATH=/data/forenzx.db
# SQLite with WAL mode, foreign_keys=ON, busy_timeout=10s.
# Schema is versioned (core/migrations.py); backups live under BACKUPS_DIR.

# ── WORKER ─────────────────────────────────────────────────────────────
WORKER_POOL_SIZE=4
WORKER_MAX_MEMORY_MB=4096
WORKER_MAX_CPU_CORES=2.0
WORKER_TIMEOUT_SECONDS=3600

# ── EVIDENCE ───────────────────────────────────────────────────────────
VAULT_BASE_DIR=/var/forensics/vault
SCRATCH_BASE_DIR=/tmp/forenzx_scratch
PACKS_DIR=./packs
# Pack manifests MUST pin image digests (sha256:...). Placeholder digests
# fail closed: the pack is DISABLED in production, never auto-fixed.

# ── THREAT_INTEL ───────────────────────────────────────────────────────
THREAT_INTEL_DIR=/var/forensics/threat_intel

# ── SIGNING ────────────────────────────────────────────────────────────
# HMAC execution signing uses SERVER_HMAC_SIGNING_KEY (see AUTH above).
# The Ed25519 signing key pair is file-based (not an env var):
# generated under DATA_DIR on first run; see docs/security/SECURITY-BOUNDARIES.md

# ── MAINTENANCE ────────────────────────────────────────────────────────
BACKUPS_DIR=/data/backups
MAINTENANCE_EVENT_RETENTION_DAYS=30

# ── OBSERVABILITY ──────────────────────────────────────────────────────
# Standard uvicorn/FastAPI logging is used today; structured log shipping
# (OTLP/Loki) is a Phase 2 backlog item. No secrets in logs — see
# docs/security/AUDIT_MODEL.md for the never-log list.
