ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# Generate long random values. Never commit real values.
JWT_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SERVER_HMAC_SIGNING_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Pydantic list values use JSON syntax.
API_KEYS=["CHANGE_ME_ANALYST_KEY"]
ADMIN_API_KEYS=["CHANGE_ME_ADMIN_KEY"]
ALLOWED_ORIGINS=["https://mcp.example.com"]

DATA_DIR=/data
DATABASE_PATH=/data/forenzx.db
BACKUPS_DIR=/data/backups
DASHBOARD_ENABLED=true

VAULT_BASE_DIR=/var/forensics/vault
SCRATCH_BASE_DIR=/tmp/forenzx_scratch
THREAT_INTEL_DIR=/var/forensics/threat_intel
PACKS_DIR=./packs

WORKER_POOL_SIZE=4
WORKER_MAX_MEMORY_MB=4096
WORKER_MAX_CPU_CORES=2.0
WORKER_TIMEOUT_SECONDS=3600

MCP_PROBE_TIMEOUT_SECONDS=8
MCP_HEALTH_INTERVAL_SECONDS=60
MCP_AUTO_HEALTH_ENABLED=true
MAINTENANCE_EVENT_RETENTION_DAYS=30
